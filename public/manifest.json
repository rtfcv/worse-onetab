{
  "name": "tab-attic",
  "description": "Stash your open tabs away and bring them back later.",
  "version": "1.2.0",
  "icons": {"128": "icons/icon.png" },
  "manifest_version": 3,
  "permissions": [
      "contextMenus",
      "storage",
      "tabs"
  ],
  "background": {
    "service_worker": "service_worker.js"
  },
  "options_ui": {
    "page": "options/options.html",
    "open_in_tab": true
  },
  "action": {
      "default_icon": {"128": "icons/icon.png" },
      "default_popup": "popup/popup.html"
  }
}
